# LedgerGuard frontend environment
# --------------------------------
# The frontend always requests the backend under "/api" on the configured origin.
# Both variables are normalized to `origin + /api` automatically, so you never
# need to include the prefix yourself:
#
#   VITE_API_URL=http://localhost:4000        -> http://localhost:4000/api
#   VITE_API_URL=http://localhost:4000/api    -> http://localhost:4000/api
#   VITE_API_BASE_URL=/api                    -> /api (Vite dev proxy)
#
# Recommended for local development (the value in `.env`):
VITE_API_URL=http://localhost:4000

# Legacy alias; only used when VITE_API_URL is not set.
# VITE_API_BASE_URL=/api