# ---- Server ----
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ---- MongoDB ----
# Full URI for the platform/global database (tenants registry + audit log).
#
# Phase 2 ACID transactions REQUIRE a replica-set MongoDB (single-node
# replica set is fine: mongod --replSet rs0). The docker-compose.yml already
# launches Mongo with --replSet rs0; adjust MONGO_URI to point at it.
MONGO_URI=mongodb://localhost:27018/ledgerguard_global
GLOBAL_DB_NAME=ledgerguard_global
# Optional: base MongoDB URI without a trailing database name.
# Defaults to MONGO_URI minus its path. Per-tenant databases are created as <base>/lg_<tenantId>.
# MONGO_BASE_URI=mongodb://localhost:27018

# ---- Redis (needed for distributed locking + cache; in-memory fallback when off) ----
# Turn REDIS_ENABLED=true on for real distributed locks + caching.
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# ---- Distributed locking (Phase 2) ----
# TTL for a held lock (ms) before it auto-expires.
LOCK_TTL_MS=10000
# How many times to retry acquiring a contended lock before giving up.
LOCK_RETRY_COUNT=3
# Delay between lock acquisition attempts (ms).
LOCK_RETRY_DELAY_MS=100
# Policy when Redis is down: 'fail_closed' rejects financial ops, 'fail_open'
# proceeds with a same-process fallback + degraded warning. Production default -> fail_closed.
LOCK_FAILURE_POLICY=fail_closed

# ---- Idempotency ----
# Retention of idempotency records (seconds) before they are auto-purged.
IDEMPOTENCY_TTL_SECONDS=86400

# ---- Payment rate limiting ----
PAYMENT_RATE_LIMIT_WINDOW_MS=900000
PAYMENT_RATE_LIMIT_MAX=60

# ---- Development-only failure simulation ----
# WARNING: keep false in production. Enables /api/dev/* endpoints used to
# demonstrate lock contention + transaction rollback.
DEV_SIMULATION_ENABLED=true

# ---- Security / JWT ----
JWT_SECRET=change-me-access-secret-long-random
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-long-random
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
# Comma-separated list of allowed browser origins (REST + Socket.IO).
# Includes both Vite ports (5173 primary, 5174 fallback).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Stricter limiter for auth endpoints (login/register/refresh/logout)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# Soft account lockout (progressive delay) after repeated failures
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_WINDOW_MS=900000
LOCKOUT_DURATION_MS=900000
# Maximum concurrent tenant DB connections before pruning
MAX_TENANT_CONNECTIONS=50

# ---- Logging ----
LOG_LEVEL=info

# ---- Platform bootstrap (super admin tenant) ----
PLATFORM_ADMIN_EMAIL=superadmin@ledgerguard.io
PLATFORM_ADMIN_PASSWORD=SuperAdmin123!
PLATFORM_ADMIN_NAME=LedgerGuard Super Admin
PLATFORM_ADMIN_TENANT=ledgerguard-platform
PLATFORM_ADMIN_COMPANY=LedgerGuard Inc.

# ---- Default development login (LOCAL DEV / DEMO ONLY - never in production) ----
# Seeded idempotently into the ledgerguard-platform tenant on every seed run.
# The three demo accounts share this password so the one-click demo login on
# the login page always matches the seeded credentials. The seed re-syncs
# each demo user's bcrypt hash on boot (see upsertDemoUser in seed.ts), so a
# change here is picked up on the next restart.
# NEVER reuse these in production.
DEV_ADMIN_EMAIL=admin@ledgerguard.com
DEV_ADMIN_PASSWORD=Admin@123
DEV_ADMIN_NAME=LedgerGuard Admin
DEV_ADMIN_ROLE=company_admin
DEV_MANAGER_EMAIL=manager@ledgerguard.com
DEV_MANAGER_PASSWORD=Admin@123
DEV_MANAGER_NAME=LedgerGuard Manager
DEV_MANAGER_ROLE=finance_manager
DEV_VIEWER_EMAIL=viewer@ledgerguard.com
DEV_VIEWER_PASSWORD=Admin@123
DEV_VIEWER_NAME=LedgerGuard Viewer
DEV_VIEWER_ROLE=viewer