# ---- Server ----
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ---- MongoDB ----
# Full URI for the platform/global database (tenants registry + audit log).
MONGO_URI=mongodb://localhost:27017/ledgerguard_global
GLOBAL_DB_NAME=ledgerguard_global
# Optional: base MongoDB URI without a trailing database name.
# Defaults to MONGO_URI minus its path. Per-tenant databases are created as <base>/lg_<tenantId>.
# MONGO_BASE_URI=mongodb://localhost:27017

# ---- Redis (optional; falls back to in-memory cache when disabled) ----
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# ---- Security / JWT ----
JWT_SECRET=change-me-access-secret-long-random
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-long-random
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
CORS_ORIGIN=http://localhost:5173

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---- Logging ----
LOG_LEVEL=info

# ---- Platform bootstrap (super admin tenant) ----
PLATFORM_ADMIN_EMAIL=superadmin@ledgerguard.io
PLATFORM_ADMIN_PASSWORD=SuperAdmin123!
PLATFORM_ADMIN_NAME=LedgerGuard Super Admin
PLATFORM_ADMIN_TENANT=ledgerguard-platform
PLATFORM_ADMIN_COMPANY=LedgerGuard Inc.

# ---- Default development login (LOCAL DEV / DEMO ONLY - never in production) ----
# Seeded idempotently into the ledgerguard-platform tenant on every seed run.
# All three demo accounts use the same "123456" password so the one-click demo
# login on the login page always matches the seeded credentials. The seed
# re-syncs each demo user's bcrypt hash on boot (see upsertDemoUser in
# seed.ts), so changing a value here is picked up on the next restart.
# NEVER reuse these in production.
DEV_ADMIN_EMAIL=admin@ledgerguard.com
DEV_ADMIN_PASSWORD=123456
DEV_ADMIN_NAME=LedgerGuard Admin
DEV_ADMIN_ROLE=company_admin
DEV_MANAGER_EMAIL=manager@ledgerguard.com
DEV_MANAGER_PASSWORD=123456
DEV_MANAGER_NAME=LedgerGuard Manager
DEV_MANAGER_ROLE=finance_manager
DEV_VIEWER_EMAIL=viewer@ledgerguard.com
DEV_VIEWER_PASSWORD=123456
DEV_VIEWER_NAME=LedgerGuard Viewer
DEV_VIEWER_ROLE=viewer