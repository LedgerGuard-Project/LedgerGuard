{
  "name": "@ledgerguard/backend",
  "version": "1.0.0",
  "description": "LedgerGuard backend API (Express + TypeScript + MongoDB)",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "predev": "powershell -ExecutionPolicy Bypass -File ../scripts/stop-stale-ledgerguard.ps1 -Ports 4000 && powershell -ExecutionPolicy Bypass -File ../scripts/start-mongo27018.ps1",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx src/database/run-seed.ts",
    "seed:analytics": "tsx src/database/run-demo-analytics-seed.ts",
    "verify:analytics": "tsx scripts/verify-analytics.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@ledgerguard/shared": "1.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.2",
    "morgan": "^1.10.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.12.7",
    "tsx": "^4.9.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}